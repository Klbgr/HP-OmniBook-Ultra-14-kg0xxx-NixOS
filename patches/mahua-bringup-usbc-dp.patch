diff --git a/arch/arm64/boot/dts/qcom/mahua-hp-omnibook-ultra-kg0xxx-bringup-dp.dts b/arch/arm64/boot/dts/qcom/mahua-hp-omnibook-ultra-kg0xxx-bringup-dp.dts
new file mode 100644
index 000000000..c3334079d
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/mahua-hp-omnibook-ultra-kg0xxx-bringup-dp.dts
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Bring-up DTB with USB-C DisplayPort back on: pmic_glink_altmode now loads
+ * in the initrd, so the DP controllers get their HPD bridge.
+ */
+
+#include "mahua-hp-omnibook-ultra-kg0xxx-bringup.dts"
+
+/ {
+	model = "HP OmniBook Ultra Laptop 14-kg0xxx (bring-up, USB-C DP)";
+};
+
+&mdss_dp0 {
+	status = "okay";
+};
+
+&mdss_dp1 {
+	status = "okay";
+};
+
+&mdss_dp2 {
+	status = "okay";
+};
